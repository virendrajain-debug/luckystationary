---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCanvas from "../components/HeroCanvas.tsx";
import Marquee from "../components/Marquee.tsx";
import TiltCard from "../components/TiltCard.tsx";
import ContactForm from "../components/ContactForm.tsx";

const PHONE_DISPLAY = "+91 94240 68398";
const PHONE_TEL = "+919424068398";
const WA_LINK =
  "https://wa.me/919424068398?text=" +
  encodeURIComponent("Hello Lucky Stationery & Sports! I have an enquiry.");
const DIRECTIONS =
  "https://www.google.com/maps/dir/?api=1&destination=22.6577263%2C75.8043461&travelmode=driving";

// Precise embed pinned to exact store coordinates (22.6577263, 75.8043461)
const MAP_EMBED =
  "https://www.google.com/maps?q=22.6577263%2C75.8043461&z=17&hl=en&output=embed";

const ADDRESS_SHORT =
  "A1 Front, 51, CAT Rd, near Surya Mandir, opposite TGF Gym, Siddhipuram Colony, Indore 452013";

const categories = [
  {
    icon: "book",
    color: "#1649d8",
    title: "School & Office",
    desc: "Pens, notebooks, files, folders, geometry boxes — every daily academic essential.",
    items: ["Notebooks", "Files", "Geometry kits", "Exam pads"],
    span: "lg:col-span-7 lg:row-span-2",
    art: "block",
  },
  {
    icon: "pen",
    color: "#e8402a",
    title: "Pens & Pencils",
    desc: "Ball, gel, markers, highlighters and refills from brands you trust.",
    items: ["Gel pens", "Markers"],
    span: "lg:col-span-5",
    art: "strip",
  },
  {
    icon: "palette",
    color: "#0f9b7a",
    title: "Art & Craft",
    desc: "Colours, brushes, sketch pens, charts and craft supplies for young creators.",
    items: ["Colours", "Brushes"],
    span: "lg:col-span-5",
    art: "strip",
  },
  {
    icon: "ball",
    color: "#14120f",
    title: "Sports Gear",
    desc: "Cricket bats, footballs, rackets, protective gear and fitness essentials.",
    items: ["Cricket", "Football", "Rackets"],
    span: "lg:col-span-5",
    art: "strip",
  },
  {
    icon: "game",
    color: "#1649d8",
    title: "Games & Toys",
    desc: "Board games, puzzles and indoor fun for every age group.",
    items: ["Board games", "Puzzles"],
    span: "lg:col-span-4",
    art: "strip",
  },
  {
    icon: "gift",
    color: "#e8402a",
    title: "Gifts & Novelty",
    desc: "Gift wrap, cards, diaries, keychains — creative little surprises.",
    items: ["Gift wrap", "Diaries"],
    span: "lg:col-span-3",
    art: "strip",
  },
] as const;

const icons: Record<string, string> = {
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />',
  pen: '<path d="M12 19l7-7 3 3-7 7-3-3z" /><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" /><path d="M2 2l7.586 7.586" /><circle cx="11" cy="11" r="2" />',
  palette: '<circle cx="13.5" cy="6.5" r=".5" /><circle cx="17.5" cy="10.5" r=".5" /><circle cx="8.5" cy="7.5" r=".5" /><circle cx="6.5" cy="12.5" r=".5" /><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />',
  ball: '<circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />',
  game: '<line x1="6" x2="6" y1="11" y2="11" /><line x1="8" x2="8" y1="9" y2="9" /><line x1="15" x2="15" y1="12" y2="12" /><line x1="17" x2="17" y1="14" y2="14" /><path d="M18 11a6 6 0 1 0-12 0v5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2z" />',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13" /><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" /><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5" />',
};

const reasons = [
  {
    no: "01",
    title: "Everything under one roof",
    desc: "Stationery, art supplies AND sports gear — finish three errands in one stop.",
  },
  {
    no: "02",
    title: "Students & sportspersons, both covered",
    desc: "Notebooks and exam pads on one shelf, cricket bats and rackets on the next.",
  },
  {
    no: "03",
    title: "A landmark location",
    desc: "Near Surya Mandir, opposite TGF Gym — an easy, familiar stop in Siddhipuram Colony.",
  },
  {
    no: "04",
    title: "Quick errands welcome",
    desc: "In and out in minutes for the one thing you forgot — or browse at leisure.",
  },
];
---

<BaseLayout>
  <!-- ===================== HERO — asymmetric 12-col ===================== -->
  <section id="top" class="border-b-2 border-ink">
    <div class="shell grid gap-0 lg:grid-cols-12">
      <!-- left: type block (7 cols) -->
      <div class="relative z-10 flex flex-col justify-center border-ink py-12 lg:col-span-7 lg:border-r-2 lg:py-20 lg:pr-12">
        <span class="label flex items-center gap-2" style="animation: rise .5s ease both">
          <span class="inline-block h-2 w-2 bg-signal" aria-hidden="true"></span>
          Indore · Siddhipuram Colony · Est. local
        </span>

        <h1 class="mt-6 font-display text-[clamp(2.5rem,6.5vw,4.6rem)] leading-[0.98] font-extrabold" style="animation: rise .6s ease .1s both">
          Pens, papers &amp; <span class="hl">pitch gear</span> — one counter for
          the whole list.
        </h1>

        <p class="mt-7 max-w-lg text-[1.05rem] leading-relaxed text-ink-soft" style="animation: rise .6s ease .25s both">
          <strong class="font-extrabold text-ink">Lucky Stationery &amp; Sports</strong>
          stocks school and office supplies, art materials and sports equipment for
          students, professionals and athletes in Indore.
        </p>

        <div class="mt-8 flex flex-wrap gap-3" style="animation: rise .6s ease .38s both">
          <a href="#contact" class="btn btn-ink">
            Send a query
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href={DIRECTIONS} target="_blank" rel="noopener" class="btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 11l19-9-9 19-2-8-8-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            </svg>
            Get directions
          </a>
        </div>

        <!-- meta ledger -->
        <dl class="mt-11 grid max-w-lg grid-cols-2 gap-px border-2 border-ink bg-ink sm:grid-cols-3" style="animation: rise .6s ease .5s both">
          <div class="bg-card px-4 py-3.5">
            <dt class="label">Call</dt>
            <dd class="mt-1 font-mono text-[13px] font-bold">
              <a href={`tel:${PHONE_TEL}`} class="hover:text-signal">{PHONE_DISPLAY}</a>
            </dd>
          </div>
          <div class="bg-card px-4 py-3.5">
            <dt class="label">Landmark</dt>
            <dd class="mt-1 font-mono text-[13px] font-bold">Near Surya Mandir</dd>
          </div>
          <div class="col-span-2 bg-card px-4 py-3.5 sm:col-span-1">
            <dt class="label">Hours</dt>
            <dd class="mt-1 font-mono text-[13px] font-bold">09:00–21:00 · Daily</dd>
          </div>
        </dl>
      </div>

      <!-- right: 3D island (5 cols, offset) -->
      <div class="relative lg:col-span-5" id="hero-canvas">
        <div class="relative h-[320px] sm:h-[420px] lg:h-full lg:min-h-[560px]">
          <!-- flat CSS fallback art (no gradients) -->
          <div class="absolute inset-0 grid place-items-center overflow-hidden" aria-hidden="true">
            <div class="relative h-56 w-44 -rotate-3 border-2 border-ink bg-sun shadow-[7px_7px_0_var(--color-ink)] sm:h-64 sm:w-52">
              <div class="absolute inset-x-3 top-4 border-b-2 border-ink pb-2 font-mono text-[10px] font-bold tracking-widest">NOTEBOOK №1</div>
              <div class="absolute inset-x-3 top-12 space-y-3" style="background: repeating-linear-gradient(transparent, transparent 13px, rgb(20 18 15 / 0.25) 13px, rgb(20 18 15 / 0.25) 14px); height: 60%"></div>
              <div class="absolute -right-10 -bottom-8 h-20 w-20 rotate-6 border-2 border-ink bg-signal shadow-[5px_5px_0_var(--color-ink)]"></div>
              <div class="absolute -left-9 -top-7 h-16 w-16 -rotate-6 border-2 border-ink bg-card shadow-[5px_5px_0_var(--color-ink)]"></div>
            </div>
          </div>

          <!-- React island: three.js scene (lazy) -->
          <HeroCanvas client:visible />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MARQUEE ===================== -->
  <Marquee client:visible />

  <!-- ===================== 01 CATEGORIES — bento ===================== -->
  <section id="shop" class="border-b-2 border-ink py-16 sm:py-24">
    <div class="shell">
      <header class="reveal flex flex-wrap items-end justify-between gap-6 border-b-2 border-ink pb-6">
        <div>
          <span class="sec-no">SEC / 01</span>
          <h2 class="mt-2 max-w-xl text-[clamp(1.8rem,4vw,2.8rem)] leading-[1.02] font-extrabold">
            Six aisles,<br />one bill counter.
          </h2>
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-ink-soft">
          Curated ranges for students, professionals, artists and athletes — walk in
          for one thing, walk out with the whole list.
        </p>
      </header>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-12">
        {
          categories.map((c, i) => (
            <TiltCard client:visible className={`h-full ${c.span}`} max={6}>
              <article
                class="card card-hover reveal flex h-full flex-col p-6"
                style={`--d:${(i % 3) * 0.07}s`}
                aria-labelledby={`cat-${i}`}
              >
                <div class="flex items-start justify-between gap-4">
                  <span
                    class="grid h-11 w-11 shrink-0 place-items-center border-[1.5px] border-ink"
                    style={`background:${c.color}; color:#fff`}
                    aria-hidden="true"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={icons[c.icon]}
                    />
                  </span>
                  <span class="label">{String(i + 1).padStart(2, "0")}</span>
                </div>

                <h3 id={`cat-${i}`} class="mt-5 text-[1.35rem] leading-tight font-extrabold">
                  {c.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{c.desc}</p>

                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {c.items.map((it) => (
                    <li class="border border-ink/25 bg-paper px-2.5 py-1 font-mono text-[11px] font-bold tracking-wide uppercase">
                      {it}
                    </li>
                  ))}
                </ul>

                <a
                  href="#contact"
                  class="mt-auto inline-flex items-center gap-1.5 pt-5 font-mono text-[12px] font-bold tracking-wide uppercase"
                  style={`color:${c.color}`}
                >
                  Enquire
                  <span aria-hidden="true">→</span>
                  <span class="sr-only">about {c.title}</span>
                </a>
              </article>
            </TiltCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== 02 WHY — numbered ledger list ===================== -->
  <section id="why" class="border-b-2 border-ink bg-card py-16 sm:py-24">
    <div class="shell grid gap-10 lg:grid-cols-12">
      <div class="reveal lg:col-span-5 lg:sticky lg:top-24 lg:self-start">
        <span class="sec-no">SEC / 02</span>
        <h2 class="mt-2 text-[clamp(1.8rem,4vw,2.8rem)] leading-[1.02] font-extrabold">
          Built for quick errands &amp; <span class="hl">big hauls</span> alike.
        </h2>
        <p class="lede mt-5">
          Grab a pen before class or kit out an entire team — either way you get
          fair prices and friendly help at the counter.
        </p>

        <div class="mt-7 border-2 border-ink bg-paper p-5">
          <p class="label">Regulars</p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {
              ["School students", "Coaching institutes", "Parents", "Office goers", "Local cricket teams", "Artists"].map((t) => (
                <span class="border border-ink/30 bg-card px-2.5 py-1 font-mono text-[11px] font-bold uppercase">
                  {t}
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <ol class="reveal border-t-2 border-ink lg:col-span-7" style="--d:.1s">
        {
          reasons.map((r, i) => (
            <li class="group grid grid-cols-[auto_1fr] gap-x-5 gap-y-1 border-b-2 border-ink px-1 py-7 transition-colors hover:bg-sun/25 sm:px-3">
              <span class="font-mono text-sm font-bold text-signal transition-transform group-hover:translate-x-1">
                {r.no}
              </span>
              <div>
                <h3 class="text-xl leading-tight font-extrabold sm:text-2xl">{r.title}</h3>
                <p class="mt-2 max-w-lg text-sm leading-relaxed text-ink-soft">{r.desc}</p>
              </div>
              <span
                class="col-start-2 mt-3 font-mono text-[11px] font-bold tracking-widest text-ink-faint uppercase opacity-0 transition-opacity group-hover:opacity-100"
                aria-hidden="true"
              >
                ← ask in store
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== 03 ABOUT — editorial split ===================== -->
  <section id="about" class="border-b-2 border-ink py-16 sm:py-24">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- flat collage -->
      <div class="reveal relative order-2 min-h-[300px] lg:order-1 lg:col-span-5">
        <div class="absolute top-0 left-0 w-[78%] border-2 border-ink bg-card p-6 shadow-[7px_7px_0_var(--color-ink)]">
          <p class="label">Since the shop opened</p>
          <p class="mt-3 font-display text-[2rem] leading-none font-extrabold">
            1 roof,<br />2 departments.
          </p>
          <div class="dotline my-4" aria-hidden="true"></div>
          <p class="font-mono text-[11px] leading-relaxed tracking-wide text-ink-soft uppercase">
            Stationery counter<br />Sports counter
          </p>
        </div>
        <div class="absolute right-0 bottom-0 w-[70%] border-2 border-ink bg-sun p-6 shadow-[7px_7px_0_var(--color-ink)]">
          <p class="label text-ink/70">Coordinates</p>
          <p class="mt-2 font-mono text-sm leading-relaxed font-bold">
            22.6577263° N<br />75.8043461° E
          </p>
          <div class="dotline my-4" aria-hidden="true"></div>
          <p class="text-sm leading-snug font-bold">
            CAT Rd · near Surya Mandir<br />opp. TGF Gym, Indore 452013
          </p>
        </div>
        <div class="absolute top-[42%] left-[58%] hidden h-16 w-16 rotate-6 border-2 border-ink bg-signal shadow-[5px_5px_0_var(--color-ink)] sm:block" aria-hidden="true">
          <span class="grid h-full w-full place-items-center font-mono text-[10px] font-bold text-white">MP</span>
        </div>
      </div>

      <!-- copy -->
      <div class="order-1 lg:order-2 lg:col-span-7">
        <span class="sec-no reveal">SEC / 03</span>
        <h2 class="reveal mt-2 text-[clamp(1.8rem,4vw,2.8rem)] leading-[1.02] font-extrabold" style="--d:.06s">
          A versatile retail destination in the heart of Indore.
        </h2>
        <p class="reveal mt-5 text-[1.05rem] leading-relaxed text-ink-soft" style="--d:.12s">
          <strong class="font-extrabold text-ink">Lucky Stationery &amp; Sports</strong>
          caters to both academic needs and athletic enthusiasts. Traditional stationery
          sits beside sporting equipment, so one visit covers multiple needs.
        </p>

        <dl class="reveal mt-8 grid gap-px border-2 border-ink bg-ink sm:grid-cols-3" style="--d:.18s">
          <div class="bg-card p-5">
            <dt class="font-mono text-[11px] font-bold tracking-widest text-signal uppercase">Dept. A</dt>
            <dd class="mt-2 font-display text-lg leading-tight font-extrabold">School &amp; office supplies</dd>
            <dd class="mt-1.5 text-sm leading-relaxed text-ink-soft">Pens, notebooks, files and art materials.</dd>
          </div>
          <div class="bg-card p-5">
            <dt class="font-mono text-[11px] font-bold tracking-widest text-signal uppercase">Dept. B</dt>
            <dd class="mt-2 font-display text-lg leading-tight font-extrabold">Sports gear</dd>
            <dd class="mt-1.5 text-sm leading-relaxed text-ink-soft">Balls, rackets and protective gear.</dd>
          </div>
          <div class="bg-card p-5">
            <dt class="font-mono text-[11px] font-bold tracking-widest text-signal uppercase">Extras</dt>
            <dd class="mt-2 font-display text-lg leading-tight font-extrabold">Gifts &amp; novelty</dd>
            <dd class="mt-1.5 text-sm leading-relaxed text-ink-soft">Craft supplies and creative surprises.</dd>
          </div>
        </dl>

        <div class="reveal mt-8 flex flex-wrap gap-3" style="--d:.24s">
          <a href={`tel:${PHONE_TEL}`} class="btn btn-ink">Call the store</a>
          <a href={WA_LINK} target="_blank" rel="noopener" class="btn btn-wa">WhatsApp us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== 04 FIND US — precise map ===================== -->
  <section id="find" class="border-b-2 border-ink bg-card py-16 sm:py-24">
    <div class="shell">
      <header class="reveal flex flex-wrap items-end justify-between gap-6 border-b-2 border-ink pb-6">
        <div>
          <span class="sec-no">SEC / 04</span>
          <h2 class="mt-2 text-[clamp(1.8rem,4vw,2.8rem)] leading-[1.02] font-extrabold">
            Easy to reach,<br />hard to miss.
          </h2>
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-ink-soft">
          Near Surya Mandir, opposite TGF Gym — right in the Siddhipuram Colony
          local hub. Tap the map for turn-by-turn directions.
        </p>
      </header>

      <div class="mt-8 grid gap-4 lg:grid-cols-12">
        <!-- address ledger -->
        <div class="reveal card flex flex-col p-6 lg:col-span-4">
          <h3 class="font-display text-xl leading-tight font-extrabold">
            Lucky Stationery &amp; Sports
          </h3>
          <address class="mt-3 text-sm leading-relaxed text-ink-soft not-italic">
            {ADDRESS_SHORT}
          </address>

          <div class="dotline my-5" aria-hidden="true"></div>

          <dl class="space-y-3 font-mono text-[13px]">
            <div class="flex items-baseline justify-between gap-3">
              <dt class="font-bold text-ink-faint">TEL</dt>
              <dd><a href={`tel:${PHONE_TEL}`} class="font-bold hover:text-signal">{PHONE_DISPLAY}</a></dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="font-bold text-ink-faint">HOURS</dt>
              <dd class="font-bold">09:00–21:00</dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="font-bold text-ink-faint">DAYS</dt>
              <dd class="font-bold">Open all week</dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="font-bold text-ink-faint">LAT</dt>
              <dd class="font-bold">22.6577263</dd>
            </div>
            <div class="flex items-baseline justify-between gap-3">
              <dt class="font-bold text-ink-faint">LNG</dt>
              <dd class="font-bold">75.8043461</dd>
            </div>
          </dl>

          <div class="dotline my-5" aria-hidden="true"></div>

          <p class="label mb-3">Neighbours</p>
          <ul class="flex flex-wrap gap-1.5">
            {
              ["Surya Mandir", "TGF Gym", "Triangle Trendz", "Treasure Fantasy"].map((n) => (
                <li class="border border-ink/30 bg-paper px-2.5 py-1 font-mono text-[11px] font-bold uppercase">{n}</li>
              ))
            }
          </ul>

          <div class="mt-auto grid gap-2.5 pt-7">
            <a href={DIRECTIONS} target="_blank" rel="noopener" class="btn btn-ink btn-block">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M3 11l19-9-9 19-2-8-8-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              </svg>
              Get directions
            </a>
            <div class="grid grid-cols-2 gap-2.5">
              <a href={`tel:${PHONE_TEL}`} class="btn btn-sm">Call</a>
              <a href={WA_LINK} target="_blank" rel="noopener" class="btn btn-wa btn-sm">WhatsApp</a>
            </div>
          </div>
        </div>

        <!-- precise map -->
        <figure class="reveal card overflow-hidden p-0 lg:col-span-8" style="--d:.1s">
          <figcaption class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-ink px-4 py-3">
            <span class="font-mono text-[11px] font-bold tracking-widest uppercase">
              Google Maps · pinned to store coordinates
            </span>
            <a
              href={DIRECTIONS}
              target="_blank"
              rel="noopener"
              class="font-mono text-[11px] font-bold tracking-widest text-royal uppercase underline underline-offset-4 hover:text-signal"
            >
              Open in Maps ↗
            </a>
          </figcaption>
          <iframe
            title="Google Map — exact location of Lucky Stationery & Sports, Indore (22.6577263, 75.8043461)"
            src={MAP_EMBED}
            class="block h-[320px] w-full border-0 sm:h-[400px] lg:h-[480px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===================== 05 CONTACT ===================== -->
  <section id="contact" class="py-16 sm:py-24">
    <div class="shell grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="reveal lg:col-span-5">
        <span class="sec-no">SEC / 05</span>
        <h2 class="mt-2 text-[clamp(1.8rem,4vw,2.8rem)] leading-[1.02] font-extrabold">
          Got a query?<br /><span class="hl">WhatsApp handles it.</span>
        </h2>
        <p class="lede mt-5">
          Fill the form — your message opens directly in WhatsApp, pre-filled and
          addressed to the store number. No email black holes; replies during shop
          hours.
        </p>

        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          <a href={`tel:${PHONE_TEL}`} class="card card-hover group p-5">
            <span class="label">Direct line</span>
            <p class="mt-2 font-display text-lg font-extrabold group-hover:text-signal">{PHONE_DISPLAY}</p>
          </a>
          <a href={WA_LINK} target="_blank" rel="noopener" class="card card-hover group p-5">
            <span class="label">WhatsApp</span>
            <p class="mt-2 font-display text-lg font-extrabold group-hover:text-mint">Chat instantly</p>
          </a>
        </div>

        <div class="mt-5 border-l-4 border-signal bg-card py-3.5 pr-4 pl-4 text-sm leading-relaxed text-ink-soft">
          <strong class="font-extrabold text-ink">Tip:</strong> name the items, brands
          and quantities — availability and price come back in one reply.
        </div>
      </div>

      <div class="reveal lg:col-span-7" style="--d:.1s">
        <ContactForm client:visible />
      </div>
    </div>
  </section>
</BaseLayout>
