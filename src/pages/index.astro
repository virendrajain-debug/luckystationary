---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCanvas from "../components/HeroCanvas.tsx";
import Marquee from "../components/Marquee.tsx";
import TiltCard from "../components/TiltCard.tsx";
import ContactForm from "../components/ContactForm.tsx";

const PHONE_DISPLAY = "+91 94240 68398";
const PHONE_TEL = "+919424068398";
const WA_LINK =
  "https://wa.me/919424068398?text=" +
  encodeURIComponent("Hello Lucky Stationery & Sports! I have an enquiry.");
const WA_GENERAL =
  "https://wa.me/919424068398?text=" +
  encodeURIComponent("Hi! I found your website and would like to know more.");
const DIRECTIONS =
  "https://www.google.com/maps/dir/?api=1&destination=22.6577263,75.8043461";
const MAP_EMBED =
  "https://www.google.com/maps?q=Lucky%20Stationery%20%26%20Sports%2C%20Siddhipuram%20Colony%2C%20Indore&z=16&output=embed";

const ADDRESS_SHORT =
  "A1 Front, 51, CAT Rd, near Surya Mandir, opposite TGF Gym, Siddhipuram Colony, Indore 452013";
const ADDRESS_FULL =
  "A1 Front, 51, CAT Rd, near Surya Mandir, opposite TGF Gym Triangle trendz, Siddhipuram Colony, Treasure Fantasy, Indore, Madhya Pradesh 452013";

const categories = [
  {
    icon: "book",
    color: "#2563eb",
    tint: "rgb(37 99 235 / 0.1)",
    title: "School & Office",
    desc: "Pens, notebooks, files, folders, geometry boxes and every daily academic essential.",
    items: ["Notebooks", "Files & Folders", "Geometry Kits"],
  },
  {
    icon: "pen",
    color: "#f2a200",
    tint: "rgb(255 201 60 / 0.16)",
    title: "Pens & Pencils",
    desc: "Ball pens, gel pens, markers, pencils, highlighters and refills from trusted brands.",
    items: ["Gel & Ball Pens", "Markers", "Sharpeners"],
  },
  {
    icon: "palette",
    color: "#ff6b57",
    tint: "rgb(255 107 87 / 0.12)",
    title: "Art & Craft",
    desc: "Colours, brushes, sketch pens, charts and craft supplies for young creators.",
    items: ["Colours", "Brushes", "Craft Sheets"],
  },
  {
    icon: "ball",
    color: "#22c7a9",
    tint: "rgb(34 199 169 / 0.14)",
    title: "Sports Gear",
    desc: "Cricket bats, footballs, rackets, protective gear and fitness essentials.",
    items: ["Cricket", "Football", "Rackets"],
  },
  {
    icon: "game",
    color: "#7c5cff",
    tint: "rgb(124 92 255 / 0.12)",
    title: "Games & Toys",
    desc: "Board games, puzzles, indoor fun and novelty toys for every age group.",
    items: ["Board Games", "Puzzles", "Toys"],
  },
  {
    icon: "gift",
    color: "#e11d48",
    tint: "rgb(225 29 72 / 0.1)",
    title: "Gifts & Novelty",
    desc: "Gift wrap, cards, diaries, keychains and creative little surprises.",
    items: ["Gift Wrap", "Cards", "Diaries"],
  },
] as const;

const icons: Record<string, string> = {
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />',
  pen: '<path d="M12 19l7-7 3 3-7 7-3-3z" /><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" /><path d="M2 2l7.586 7.586" /><circle cx="11" cy="11" r="2" />',
  palette: '<circle cx="13.5" cy="6.5" r=".5" /><circle cx="17.5" cy="10.5" r=".5" /><circle cx="8.5" cy="7.5" r=".5" /><circle cx="6.5" cy="12.5" r=".5" /><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />',
  ball: '<circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />',
  game: '<line x1="6" x2="6" y1="11" y2="11" /><line x1="8" x2="8" y1="9" y2="9" /><line x1="15" x2="15" y1="12" y2="12" /><line x1="17" x2="17" y1="14" y2="14" /><path d="M18 11a6 6 0 1 0-12 0v5a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2z" />',
  gift: '<rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13" /><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" /><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5" />',
};

const features = [
  {
    title: "Everything under one roof",
    desc: "Stationery, art supplies AND sports gear — finish multiple errands in one quick stop.",
    icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
    accent: "#2563eb",
  },
  {
    title: "For students & sportspersons",
    desc: "From notebooks and exam pads to cricket bats, footballs and rackets — we've got both sides covered.",
    icon: '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>',
    accent: "#22c7a9",
  },
  {
    title: "Prime local location",
    desc: "Right near Surya Mandir and opposite TGF Gym on CAT Road — an easy, familiar stop in Siddhipuram Colony.",
    icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
    accent: "#ff6b57",
  },
  {
    title: "Quick errands welcome",
    desc: "In and out in minutes for that one thing you forgot — or browse at leisure for a bigger haul.",
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
    accent: "#7c5cff",
  },
];
---

<BaseLayout>
  <!-- ===================== HERO ===================== -->
  <section id="top" class="relative overflow-hidden">
    <div class="orb -top-28 -left-24 h-[26rem] w-[26rem] bg-sun/45"></div>
    <div class="orb top-10 -right-32 h-[28rem] w-[28rem] bg-royal/15"></div>
    <div class="orb bottom-0 left-1/3 h-72 w-72 bg-coral/15"></div>

    <div class="shell relative grid items-center gap-10 pb-8 pt-14 md:min-h-[86vh] md:grid-cols-[1.05fr_1fr] md:pb-0 md:pt-6">
      <!-- copy -->
      <div class="relative z-10 max-w-2xl">
        <span class="eyebrow" style="animation: blur-in .7s ease both">
          <span class="h-1.5 w-1.5 rounded-full bg-wa"></span>
          Indore · Siddhipuram Colony
        </span>

        <h1 class="mt-6 font-display text-[clamp(2.4rem,7vw,4.4rem)] leading-[1.03] font-extrabold">
          <span class="hero-word" style="--i:0">Everything</span>
          <span class="hero-word" style="--i:1">you</span>
          <span class="hero-word" style="--i:2">need,</span><br />
          <span class="hero-word grad-text" style="--i:3">stationery</span>
          <span class="hero-word" style="--i:4">&amp;</span>
          <span class="hero-word grad-text" style="--i:5">sports.</span>
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg" style="animation: blur-in .8s ease .6s both">
          <strong class="font-extrabold text-ink">Lucky Stationery &amp; Sports</strong> is your
          one-stop shop in Indore — pens, notebooks, files and art materials for students
          and professionals, plus balls, rackets and protective gear for athletes.
        </p>

        <div class="mt-8 flex flex-wrap gap-3" style="animation: blur-in .8s ease .78s both">
          <a href="#contact" class="btn btn-ink">
            Send a query
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href={DIRECTIONS} target="_blank" rel="noopener" class="btn btn-ghost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 11l19-9-9 19-2-8-8-2z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
            </svg>
            Get directions
          </a>
        </div>

        <dl class="mt-10 flex flex-wrap gap-x-8 gap-y-4" style="animation: blur-in .8s ease .95s both">
          <div>
            <dt class="text-xs font-bold tracking-widest text-ink-faint uppercase">Call us</dt>
            <dd class="mt-1 font-display text-lg font-extrabold">
              <a href={`tel:${PHONE_TEL}`} class="hover:text-royal">{PHONE_DISPLAY}</a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold tracking-widest text-ink-faint uppercase">Landmark</dt>
            <dd class="mt-1 font-display text-lg font-extrabold">Near Surya Mandir</dd>
          </div>
          <div>
            <dt class="text-xs font-bold tracking-widest text-ink-faint uppercase">Open</dt>
            <dd class="mt-1 font-display text-lg font-extrabold">All week · 9 AM – 9 PM</dd>
          </div>
        </dl>
      </div>

      <!-- 3D island -->
      <div class="relative z-0 h-[340px] sm:h-[440px] md:h-[600px]" id="hero-canvas">
        <!-- CSS fallback art (visible until / unless WebGL loads) -->
        <div class="absolute inset-0 grid place-items-center" aria-hidden="true">
          <div class="animate-floaty relative">
            <div class="h-52 w-40 -rotate-6 rounded-2xl bg-gradient-to-br from-royal to-grape shadow-pop sm:h-64 sm:w-52"></div>
            <div class="absolute -top-8 -right-10 h-40 w-28 rotate-12 rounded-2xl bg-gradient-to-br from-sun to-sun-deep shadow-pop sm:h-52 sm:w-36"></div>
            <div class="absolute -bottom-10 -left-12 h-32 w-44 rotate-3 rounded-2xl bg-gradient-to-br from-mint to-royal shadow-pop"></div>
            <div class="absolute -right-14 -bottom-6 h-20 w-20 rounded-full bg-gradient-to-br from-coral to-sun shadow-pop"></div>
          </div>
        </div>

        <!-- React island: three.js scene (lazy) -->
        <HeroCanvas client:visible />

        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-paper to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- ===================== MARQUEE ===================== -->
  <Marquee client:visible />

  <!-- ===================== CATEGORIES ===================== -->
  <section id="shop" class="relative py-16 sm:py-24">
    <div class="orb top-10 -right-24 h-80 w-80 bg-grape/10"></div>
    <div class="shell relative">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow">What we stock</span>
        <h2 class="mt-5 text-[clamp(1.9rem,4.5vw,3rem)] font-extrabold leading-tight">
          One shop. <span class="grad-text">Six worlds</span> to explore.
        </h2>
        <p class="mt-4 text-ink-soft">
          Curated ranges for students, professionals, artists and athletes — all in one visit.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((c, i) => (
            <TiltCard client:visible className="h-full" max={7}>
              <article
                class="card reveal h-full p-6"
                style={`--d:${(i % 3) * 0.08}s; background: linear-gradient(160deg, #ffffff 0%, ${c.tint} 220%)`}
              >
                <div
                  class="grid h-14 w-14 place-items-center rounded-2xl"
                  style={`background:${c.tint}; color:${c.color}`}
                >
                  <svg
                    width="26"
                    height="26"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={icons[c.icon]}
                  />
                </div>
                <h3 class="mt-5 text-xl font-extrabold">{c.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{c.desc}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {c.items.map((it) => (
                    <li
                      class="rounded-full border border-ink/10 bg-white/80 px-3 py-1 text-xs font-bold text-ink-soft"
                    >
                      {it}
                    </li>
                  ))}
                </ul>
                <a
                  href="#contact"
                  class="mt-5 inline-flex items-center gap-1.5 text-sm font-extrabold"
                  style={`color:${c.color}`}
                >
                  Enquire about this
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M5 12h14M13 6l6 6-6 6"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </article>
            </TiltCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== WHY US ===================== -->
  <section id="why" class="relative border-y border-ink/8 bg-white py-16 sm:py-24">
    <div class="shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="reveal">
        <span class="eyebrow">Why Lucky</span>
        <h2 class="mt-5 text-[clamp(1.9rem,4.5vw,3rem)] font-extrabold leading-tight">
          Built for quick errands<br class="hidden sm:block" />
          <span class="grad-text">&amp; big hauls alike.</span>
        </h2>
        <p class="mt-4 max-w-md leading-relaxed text-ink-soft">
          Whether you're grabbing a pen before class or kitting up an entire team,
          you'll find quality picks at fair prices — with friendly help at the counter.
        </p>

        <div class="mt-8 rounded-3xl border border-ink/8 bg-paper-2 p-6">
          <p class="text-sm font-bold text-ink-soft">Popular with</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              ["School students", "College & coaching", "Parents", "Office goers", "Local cricket teams", "Artists & hobbyists"].map((t) => (
                <span class="rounded-full bg-white px-3.5 py-1.5 text-xs font-extrabold shadow-[0_6px_16px_-10px_rgb(15_23_42/0.6)]">
                  {t}
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          features.map((f, i) => (
            <div class="card reveal p-6" style={`--d:${i * 0.08}s`}>
              <div
                class="grid h-12 w-12 place-items-center rounded-2xl"
                style={`background:${f.accent}1f; color:${f.accent}`}
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={f.icon}
                />
              </div>
              <h3 class="mt-4 text-lg font-extrabold">{f.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{f.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT ===================== -->
  <section id="about" class="relative overflow-hidden py-16 sm:py-24">
    <div class="orb -left-24 top-20 h-80 w-80 bg-sun/35"></div>
    <div class="shell relative grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="reveal relative order-2 lg:order-1">
        <!-- stacked 3D-ish illustration -->
        <div class="relative mx-auto h-[330px] w-full max-w-md">
          <div class="absolute inset-x-6 top-4 h-56 rotate-[-6deg] rounded-[2rem] bg-gradient-to-br from-royal via-grape to-coral shadow-pop"></div>
          <div class="absolute inset-x-10 top-14 h-56 rotate-[3deg] rounded-[2rem] bg-white shadow-pop ring-1 ring-ink/8"></div>
          <div class="absolute inset-x-3 bottom-2 h-40 rotate-[-2deg] rounded-[2rem] bg-gradient-to-br from-sun to-sun-deep shadow-pop"></div>

          <div class="absolute right-2 bottom-8 rounded-2xl bg-white px-5 py-4 shadow-pop ring-1 ring-ink/8">
            <p class="font-display text-2xl font-extrabold text-ink">1 shop</p>
            <p class="text-xs font-bold tracking-wide text-ink-faint uppercase">
              Stationery + Sports
            </p>
          </div>
          <div class="absolute top-2 left-2 rounded-2xl bg-ink px-5 py-4 text-paper shadow-pop">
            <p class="font-display text-2xl font-extrabold text-sun">Indore</p>
            <p class="text-xs font-bold tracking-wide text-white/60 uppercase">
              Siddhipuram Colony
            </p>
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <span class="eyebrow reveal">About the store</span>
        <h2 class="reveal mt-5 text-[clamp(1.9rem,4.5vw,3rem)] font-extrabold leading-tight" style="--d:.08s">
          A versatile retail destination in the heart of Indore.
        </h2>
        <p class="reveal mt-5 leading-relaxed text-ink-soft" style="--d:.16s">
          <strong class="font-extrabold text-ink">Lucky Stationery &amp; Sports</strong> caters
          to both academic needs and athletic enthusiasts. The store combines traditional
          stationery with sporting equipment, so customers can fulfil multiple needs in a
          single visit.
        </p>
        <ul class="mt-6 space-y-3">
          {
            [
              ["School & office supplies", "Pens, notebooks, files and art materials for daily academic and professional tasks."],
              ["Sports gear", "Balls, rackets and protective gear for athletes and hobbyists alike."],
              ["Novelty items", "Unique gifts and craft supplies that add a creative touch to everyday shopping."],
            ].map(([t, d], i) => (
              <li class="reveal flex gap-3.5" style={`--d:${0.2 + i * 0.08}s`}>
                <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-wa/15 text-wa-deep">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span>
                  <strong class="block font-extrabold text-ink">{t}</strong>
                  <span class="text-sm leading-relaxed text-ink-soft">{d}</span>
                </span>
              </li>
            ))
          }
        </ul>

        <div class="reveal mt-8 flex flex-wrap gap-3" style="--d:.45s">
          <a href={`tel:${PHONE_TEL}`} class="btn btn-ink">Call the store</a>
          <a href={WA_GENERAL} target="_blank" rel="noopener" class="btn btn-wa">WhatsApp us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MAP / FIND US ===================== -->
  <section id="find" class="relative border-y border-ink/8 bg-white py-16 sm:py-24">
    <div class="shell">
      <div class="reveal mx-auto max-w-2xl text-center">
        <span class="eyebrow">Find us</span>
        <h2 class="mt-5 text-[clamp(1.9rem,4.5vw,3rem)] font-extrabold leading-tight">
          Easy to reach, <span class="grad-text">hard to miss.</span>
        </h2>
        <p class="mt-4 text-ink-soft">
          Near Surya Mandir, opposite TGF Gym — right in the Siddhipuram Colony local hub.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-[1fr_1.35fr]">
        <!-- address card -->
        <div class="reveal card flex flex-col p-6 sm:p-8">
          <div class="flex items-start gap-4">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-royal/10 text-royal">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <div>
              <h3 class="text-lg font-extrabold">Lucky Stationery &amp; Sports</h3>
              <address class="mt-1.5 text-sm leading-relaxed text-ink-soft not-italic">
                {ADDRESS_SHORT}
              </address>
            </div>
          </div>

          <dl class="mt-6 space-y-4 border-t border-ink/8 pt-6 text-sm">
            <div class="flex justify-between gap-4">
              <dt class="font-bold text-ink-faint">Phone</dt>
              <dd><a href={`tel:${PHONE_TEL}`} class="font-extrabold hover:text-royal">{PHONE_DISPLAY}</a></dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="font-bold text-ink-faint">Hours</dt>
              <dd class="font-extrabold">9:00 AM – 9:00 PM</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="font-bold text-ink-faint">Days</dt>
              <dd class="font-extrabold">Open all week</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="font-bold text-ink-faint">Nearby</dt>
              <dd class="text-right font-extrabold">Surya Mandir · TGF Gym · Triangle Trendz</dd>
            </div>
          </dl>

          <div class="mt-auto grid gap-3 pt-7">
            <a href={DIRECTIONS} target="_blank" rel="noopener" class="btn btn-ink w-full">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M3 11l19-9-9 19-2-8-8-2z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
              </svg>
              Get directions in Google Maps
            </a>
            <div class="grid grid-cols-2 gap-3">
              <a href={`tel:${PHONE_TEL}`} class="btn btn-ghost">Call</a>
              <a href={WA_LINK} target="_blank" rel="noopener" class="btn btn-wa">WhatsApp</a>
            </div>
          </div>
        </div>

        <!-- google map -->
        <div class="reveal overflow-hidden rounded-[1.75rem] border border-ink/10 shadow-card" style="--d:.12s">
          <iframe
            title="Google Map — Lucky Stationery & Sports, Indore"
            src={MAP_EMBED}
            class="h-[340px] w-full border-0 sm:h-[420px] lg:h-full lg:min-h-[480px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            aria-label="Map showing location of Lucky Stationery and Sports in Indore"
          ></iframe>
        </div>
      </div>

      <p class="reveal mt-6 text-center text-sm text-ink-faint">
        Full address: {ADDRESS_FULL}
      </p>
    </div>
  </section>

  <!-- ===================== CONTACT ===================== -->
  <section id="contact" class="relative overflow-hidden py-16 sm:py-24">
    <div class="orb -right-20 top-16 h-96 w-96 bg-wa/20"></div>
    <div class="orb -left-24 bottom-10 h-80 w-80 bg-sun/30"></div>

    <div class="shell relative grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div class="reveal">
        <span class="eyebrow">Contact us</span>
        <h2 class="mt-5 text-[clamp(1.9rem,4.5vw,3rem)] font-extrabold leading-tight">
          Got a query?<br />
          <span class="grad-text">It lands on WhatsApp.</span>
        </h2>
        <p class="mt-4 max-w-md leading-relaxed text-ink-soft">
          Fill the form and your message opens directly in WhatsApp, pre-filled and
          addressed to our store number — no waiting on email, instant reply during
          shop hours.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <a href={`tel:${PHONE_TEL}`} class="card group p-5 transition-transform hover:-translate-y-1">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-royal text-white">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.1 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.7a2 2 0 0 1 1.7 2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              </svg>
            </span>
            <p class="mt-4 text-xs font-bold tracking-widest text-ink-faint uppercase">Call us</p>
            <p class="font-display text-lg font-extrabold group-hover:text-royal">{PHONE_DISPLAY}</p>
          </a>

          <a href={WA_GENERAL} target="_blank" rel="noopener" class="card group p-5 transition-transform hover:-translate-y-1">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-wa text-white">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.7.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.2-.7l.4-.5c.1-.2.1-.3 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2.1 3.2 5 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.4z" />
              </svg>
            </span>
            <p class="mt-4 text-xs font-bold tracking-widest text-ink-faint uppercase">WhatsApp</p>
            <p class="font-display text-lg font-extrabold group-hover:text-wa-deep">Chat instantly</p>
          </a>
        </div>

        <div class="mt-6 rounded-3xl border border-dashed border-royal/30 bg-royal/5 p-5 text-sm leading-relaxed text-ink-soft">
          <strong class="font-extrabold text-ink">Tip:</strong> mention items, brands and
          quantities in your query — we can confirm availability and price in one reply.
        </div>
      </div>

      <div class="reveal" style="--d:.1s">
        <ContactForm client:visible />
      </div>
    </div>
  </section>
</BaseLayout>
