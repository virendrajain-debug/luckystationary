---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lucky Stationery & Sports | Stationery, Art & Sports Gear in Indore",
  description = "Lucky Stationery & Sports in Siddhipuram Colony, Indore — pens, notebooks, files, art materials, sports gear, gifts & games. Near Surya Mandir, opposite TGF Gym. Call +91 94240 68398.",
} = Astro.props;

const PHONE_DISPLAY = "+91 94240 68398";
const PHONE_TEL = "+919424068398";
const WA_LINK =
  "https://wa.me/919424068398?text=" +
  encodeURIComponent(
    "Hello Lucky Stationery & Sports! I have an enquiry about your products."
  );
const DIRECTIONS =
  "https://www.google.com/maps/dir/?api=1&destination=22.6577263%2C75.8043461&travelmode=driving";
const PLACE_LINK =
  "https://www.google.com/maps/place/Lucky+Stationery+%26+Sports/@22.6577312,75.8017712,17z/data=!3m1!4b1!4m6!3m5!1s0x3962ff5dc0041739:0xf90b6acca979f9ea!8m2!3d22.6577263!4d75.8043461!16s%2Fg%2F11z90p6vr_";

const ADDRESS_FULL =
  "A1 Front, 51, CAT Rd, near Surya Mandir, opposite TGF Gym Triangle trendz, Siddhipuram Colony, Treasure Fantasy, Indore, Madhya Pradesh 452013";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "Lucky Stationery & Sports",
  description,
  telephone: PHONE_TEL,
  priceRange: "₹",
  address: {
    "@type": "PostalAddress",
    streetAddress:
      "A1 Front, 51, CAT Rd, near Surya Mandir, opposite TGF Gym Triangle trendz, Siddhipuram Colony, Treasure Fantasy",
    addressLocality: "Indore",
    addressRegion: "Madhya Pradesh",
    postalCode: "452013",
    addressCountry: "IN",
  },
  geo: { "@type": "GeoCoordinates", latitude: 22.6577263, longitude: 75.8043461 },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    opens: "09:00",
    closes: "21:00",
  },
  hasMap: "https://www.google.com/maps?q=22.6577263,75.8043461",
  sameAs: [PLACE_LINK],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="canonical"
      href={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href}
    />
    <meta name="theme-color" content="#f7f4ec" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:url"
      content={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href}
    />
    <meta property="og:site_name" content="Lucky Stationery & Sports" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- ===================== NAV ===================== -->
    <header id="nav" class="fixed inset-x-0 top-0 z-50 border-b-2 border-ink bg-paper">
      <div class="shell flex h-[64px] items-center justify-between gap-4">
        <a href="#top" class="group flex items-center gap-2.5" aria-label="Lucky Stationery & Sports — home">
          <span
            class="grid h-9 w-9 place-items-center border-[1.5px] border-ink bg-sun text-ink shadow-[2px_2px_0_var(--color-ink)] transition-transform group-hover:-translate-x-0.5 group-hover:-translate-y-0.5"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 20l4.5-1.2L20.3 7a2.1 2.1 0 0 0-3-3L5.5 15.8 4 20z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              <path d="M14.5 6.5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </span>
          <span class="leading-none">
            <span class="block font-display text-[17px] font-extrabold tracking-tight">Lucky</span>
            <span class="block font-mono text-[9.5px] font-bold tracking-[0.16em] text-ink-faint uppercase">
              Stationery &amp; Sports
            </span>
          </span>
        </a>

        <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
          <a class="nav-link" href="#shop"><span class="nav-no">01</span> Shop</a>
          <a class="nav-link" href="#why"><span class="nav-no">02</span> Why Us</a>
          <a class="nav-link" href="#about"><span class="nav-no">03</span> About</a>
          <a class="nav-link" href="#find"><span class="nav-no">04</span> Find Us</a>
          <a class="nav-link" href="#contact"><span class="nav-no">05</span> Contact</a>
        </nav>

        <div class="flex items-center gap-2">
          <a href={`tel:${PHONE_TEL}`} class="btn btn-sm hidden sm:inline-flex">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.1 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.7a2 2 0 0 1 1.7 2z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
            </svg>
            Call
          </a>
          <a href={WA_LINK} target="_blank" rel="noopener" class="btn btn-wa btn-sm hidden sm:inline-flex">
            WhatsApp
          </a>

          <button
            id="nav-toggle"
            type="button"
            class="grid h-10 w-10 place-items-center border-[1.5px] border-ink bg-card shadow-[2px_2px_0_var(--color-ink)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none lg:hidden"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden border-t-2 border-ink bg-paper lg:hidden">
        <nav class="shell flex flex-col py-3" aria-label="Mobile">
          <a class="mob-link" href="#shop">01 — Shop</a>
          <a class="mob-link" href="#why">02 — Why Us</a>
          <a class="mob-link" href="#about">03 — About</a>
          <a class="mob-link" href="#find">04 — Find Us</a>
          <a class="mob-link" href="#contact">05 — Contact</a>
          <div class="mt-3 grid grid-cols-2 gap-2 pb-2">
            <a href={`tel:${PHONE_TEL}`} class="btn btn-ink btn-sm">Call Now</a>
            <a href={WA_LINK} target="_blank" rel="noopener" class="btn btn-wa btn-sm">WhatsApp</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main" class="pt-[64px]">
      <slot />
    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="border-t-2 border-ink bg-ink text-paper">
      <div class="shell grid gap-10 py-14 md:grid-cols-[1.3fr_0.85fr_1fr]">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="grid h-9 w-9 place-items-center border-[1.5px] border-paper bg-sun text-ink">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 20l4.5-1.2L20.3 7a2.1 2.1 0 0 0-3-3L5.5 15.8 4 20z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                <path d="M14.5 6.5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </span>
            <span class="font-display text-lg font-extrabold">Lucky Stationery &amp; Sports</span>
          </div>
          <p class="mt-5 max-w-sm text-sm leading-relaxed text-paper/70">
            One shop for school &amp; office supplies, art materials, sports gear, games
            and gifts — near Surya Mandir, Siddhipuram Colony, Indore.
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            <a href={`tel:${PHONE_TEL}`} class="btn btn-sun btn-sm">Call {PHONE_DISPLAY}</a>
            <a href={WA_LINK} target="_blank" rel="noopener" class="btn btn-wa btn-sm">Chat on WhatsApp</a>
          </div>
        </div>

        <div>
          <h2 class="font-mono text-[11px] font-bold tracking-[0.16em] text-sun uppercase">Index</h2>
          <ul class="mt-4 space-y-1 text-sm font-semibold">
            <li><a class="foot-link" href="#shop">01 — Products</a></li>
            <li><a class="foot-link" href="#why">02 — Why Choose Us</a></li>
            <li><a class="foot-link" href="#about">03 — About the Store</a></li>
            <li><a class="foot-link" href="#find">04 — Map &amp; Directions</a></li>
            <li><a class="foot-link" href="#contact">05 — Contact</a></li>
          </ul>
        </div>

        <div>
          <h2 class="font-mono text-[11px] font-bold tracking-[0.16em] text-sun uppercase">Visit</h2>
          <address class="mt-4 space-y-3 text-sm leading-relaxed text-paper/70 not-italic">
            <p>{ADDRESS_FULL}</p>
            <p><a class="font-bold text-paper underline decoration-sun decoration-2 underline-offset-4 hover:text-sun" href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a></p>
            <p class="font-mono text-xs tracking-wide text-paper/50">OPEN ALL WEEK · 09:00–21:00</p>
          </address>
          <a href={DIRECTIONS} target="_blank" rel="noopener" class="btn btn-sm mt-5">Get Directions</a>
        </div>
      </div>

      <div class="border-t border-paper/20">
        <div class="shell flex flex-col items-center justify-between gap-2 py-5 font-mono text-[11px] tracking-wide text-paper/50 sm:flex-row">
          <p>© {new Date().getFullYear()} LUCKY STATIONERY &amp; SPORTS</p>
          <p>22.6577° N, 75.8043° E · INDORE, MP</p>
        </div>
      </div>
    </footer>

    <!-- ===================== FLOATING WHATSAPP + CALL ===================== -->
    <div class="fabs" aria-label="Quick contact">
      <a class="fab fab-wa" href={WA_LINK} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp" title="WhatsApp">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.7.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.2-.7l.4-.5c.1-.2.1-.3 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2.1 3.2 5 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.4z" />
        </svg>
      </a>
      <a class="fab fab-call" href={`tel:${PHONE_TEL}`} aria-label="Call Lucky Stationery and Sports" title="Call">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.1 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.7a2 2 0 0 1 1.7 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <style is:global>
      .skip-link {
        position: fixed;
        top: -100px;
        left: 1rem;
        z-index: 200;
        background: var(--color-ink);
        color: var(--color-paper);
        padding: 0.7rem 1rem;
        font-weight: 700;
        border-radius: 4px;
        transition: top 0.2s ease;
      }
      .skip-link:focus-visible { top: 1rem; }

      .nav-link {
        display: inline-flex;
        align-items: baseline;
        gap: 0.35rem;
        padding: 0.45rem 0.7rem;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--color-ink-soft);
        border-bottom: 2px solid transparent;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .nav-link:hover,
      .nav-link:focus-visible {
        color: var(--color-ink);
        border-bottom-color: var(--color-signal);
      }
      .nav-no {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        font-weight: 700;
        color: var(--color-ink-faint);
      }
      .nav-link:hover .nav-no { color: var(--color-signal); }

      .mob-link {
        display: block;
        padding: 0.85rem 0.25rem;
        font-weight: 700;
        font-size: 1rem;
        color: var(--color-ink);
        border-bottom: 1px solid var(--color-rule);
        transition: background-color 0.12s ease, padding-left 0.15s ease;
      }
      .mob-link:hover,
      .mob-link:focus-visible { background: rgb(20 18 15 / 0.05); padding-left: 0.6rem; }
      .mob-link:active { background: rgb(20 18 15 / 0.1); }

      .foot-link {
        color: rgb(247 244 236 / 0.75);
        transition: color 0.15s ease, padding-left 0.15s ease;
        display: inline-block;
      }
      .foot-link:hover,
      .foot-link:focus-visible { color: var(--color-sun); padding-left: 0.4rem; }
    </style>

    <script>
      const nav = document.getElementById("nav");
      const toggle = document.getElementById("nav-toggle");
      const menu = document.getElementById("mobile-menu");

      toggle?.addEventListener("click", () => {
        const open = menu?.classList.toggle("hidden") === false;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      });

      menu?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          menu.classList.add("hidden");
          toggle?.setAttribute("aria-expanded", "false");
        })
      );

      // Escape closes the mobile menu
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu && !menu.classList.contains("hidden")) {
          menu.classList.add("hidden");
          toggle?.setAttribute("aria-expanded", "false");
          toggle?.focus();
        }
      });

      // Scroll reveals via IntersectionObserver (no scroll listeners)
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduced || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.1 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
