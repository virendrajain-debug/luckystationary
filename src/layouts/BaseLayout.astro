---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lucky Stationery & Sports | Stationery, Art & Sports Gear in Indore",
  description = "Lucky Stationery & Sports in Siddhipuram Colony, Indore — pens, notebooks, files, art materials, sports gear, gifts & games. Near Surya Mandir, opposite TGF Gym. Call +91 94240 68398.",
} = Astro.props;

const PHONE_DISPLAY = "+91 94240 68398";
const PHONE_TEL = "+919424068398";
const WA_LINK =
  "https://wa.me/919424068398?text=" +
  encodeURIComponent(
    "Hello Lucky Stationery & Sports! I have an enquiry about your products."
  );
const MAPS_LINK =
  "https://www.google.com/maps/dir/?api=1&destination=22.6577263,75.8043461&destination_place_id=ChIJj6mW8r6Z4jkRQGmZlVQx8wQ";
const PLACE_LINK =
  "https://www.google.com/maps/place/Lucky+Stationery+%26+Sports/@22.6577312,75.8017712,17z/data=!3m1!4b1!4m6!3m5!1s0x3962ff5dc0041739:0xf90b6acca979f9ea!8m2!3d22.6577263!4d75.8043461!16s%2Fg%2F11z90p6vr_";

const ADDRESS =
  "A1 Front, 51, CAT Rd, near Surya Mandir, opposite TGF Gym Triangle trendz, Siddhipuram Colony, Treasure Fantasy, Indore, Madhya Pradesh 452013";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "Lucky Stationery & Sports",
  description,
  image: new URL("/og.jpg", Astro.site ?? Astro.url).href,
  telephone: PHONE_TEL,
  priceRange: "₹",
  address: {
    "@type": "PostalAddress",
    streetAddress:
      "A1 Front, 51, CAT Rd, near Surya Mandir, opposite TGF Gym Triangle trendz, Siddhipuram Colony, Treasure Fantasy",
    addressLocality: "Indore",
    addressRegion: "Madhya Pradesh",
    postalCode: "452013",
    addressCountry: "IN",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 22.6577263,
    longitude: 75.8043461,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "09:00",
    closes: "21:00",
  },
  hasMap: "https://www.google.com/maps/place/22.6577263,75.8043461",
  sameAs: [PLACE_LINK],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href} />
    <meta name="theme-color" content="#fffdf7" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href} />
    <meta property="og:site_name" content="Lucky Stationery & Sports" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:z-[100] focus:top-3 focus:left-3 focus:btn focus:btn-ink"
      >Skip to content</a
    >

    <!-- ===================== NAV ===================== -->
    <header
      id="nav"
      class="glass fixed inset-x-0 top-0 z-50 transition-shadow"
    >
      <div class="shell flex h-[68px] items-center justify-between gap-4">
        <a href="#top" class="group flex items-center gap-2.5">
          <span
            class="grid h-10 w-10 place-items-center rounded-2xl bg-ink text-sun shadow-[0_10px_20px_-10px_rgb(15_23_42/0.8)] transition-transform group-hover:-rotate-6"
          >
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 20l4.5-1.2L20.3 7a2.1 2.1 0 0 0-3-3L5.5 15.8 4 20z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
              <path d="M14.5 6.5l3 3" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
            </svg>
          </span>
          <span class="leading-tight">
            <span class="block font-display text-[17px] font-extrabold tracking-tight">Lucky</span>
            <span class="block text-[10.5px] font-bold tracking-[0.18em] text-ink-faint uppercase">Stationery & Sports</span>
          </span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
          <a class="nav-link" href="#shop">Shop</a>
          <a class="nav-link" href="#why">Why Us</a>
          <a class="nav-link" href="#about">About</a>
          <a class="nav-link" href="#find">Find Us</a>
          <a class="nav-link" href="#contact">Contact</a>
        </nav>

        <div class="flex items-center gap-2">
          <a href={`tel:${PHONE_TEL}`} class="btn btn-ghost btn-sm hidden sm:inline-flex">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.1 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.7a2 2 0 0 1 1.7 2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            Call
          </a>
          <a href={WA_LINK} target="_blank" rel="noopener" class="btn btn-wa btn-sm hidden sm:inline-flex">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.7.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.2-.7l.4-.5c.1-.2.1-.3 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2.1 3.2 5 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.4z" />
            </svg>
            WhatsApp
          </a>

          <button
            id="nav-toggle"
            type="button"
            class="grid h-11 w-11 place-items-center rounded-2xl border border-ink/10 bg-white/70 md:hidden"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu" class="hidden border-t border-ink/8 bg-paper/95 md:hidden">
        <nav class="shell flex flex-col gap-1 py-4" aria-label="Mobile">
          <a class="mob-link" href="#shop">Shop</a>
          <a class="mob-link" href="#why">Why Us</a>
          <a class="mob-link" href="#about">About</a>
          <a class="mob-link" href="#find">Find Us</a>
          <a class="mob-link" href="#contact">Contact</a>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <a href={`tel:${PHONE_TEL}`} class="btn btn-ink btn-sm">Call Now</a>
            <a href={WA_LINK} target="_blank" rel="noopener" class="btn btn-wa btn-sm">WhatsApp</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main" class="pt-[68px]">
      <slot />
    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="relative overflow-hidden border-t border-ink/8 bg-white">
      <div class="orb -top-24 -left-20 h-64 w-64 bg-sun/40"></div>
      <div class="orb -bottom-28 right-0 h-72 w-72 bg-royal/15"></div>
      <div class="shell relative py-14">
        <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
          <div>
            <div class="flex items-center gap-2.5">
              <span class="grid h-10 w-10 place-items-center rounded-2xl bg-ink text-sun">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 20l4.5-1.2L20.3 7a2.1 2.1 0 0 0-3-3L5.5 15.8 4 20z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
                  <path d="M14.5 6.5l3 3" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                </svg>
              </span>
              <span class="font-display text-lg font-extrabold">Lucky Stationery & Sports</span>
            </div>
            <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-soft">
              Your one-stop shop in Indore for school & office supplies, art materials,
              sports gear, games and gifts — near Surya Mandir, Siddhipuram Colony.
            </p>
            <div class="mt-5 flex flex-wrap gap-2">
              <a href={`tel:${PHONE_TEL}`} class="btn btn-ink btn-sm">Call {PHONE_DISPLAY}</a>
              <a href={WA_LINK} target="_blank" rel="noopener" class="btn btn-wa btn-sm">Chat on WhatsApp</a>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-extrabold tracking-widest text-ink-faint uppercase">Explore</h3>
            <ul class="mt-4 space-y-2.5 text-sm font-semibold text-ink-soft">
              <li><a class="hover:text-royal" href="#shop">Products</a></li>
              <li><a class="hover:text-royal" href="#why">Why Choose Us</a></li>
              <li><a class="hover:text-royal" href="#about">About the Store</a></li>
              <li><a class="hover:text-royal" href="#find">Map & Directions</a></li>
              <li><a class="hover:text-royal" href="#contact">Contact Us</a></li>
            </ul>
          </div>

          <div>
            <h3 class="text-sm font-extrabold tracking-widest text-ink-faint uppercase">Visit Us</h3>
            <address class="mt-4 space-y-3 text-sm not-italic leading-relaxed text-ink-soft">
              <p>{ADDRESS}</p>
              <p>
                <a class="font-bold text-ink hover:text-royal" href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a>
              </p>
              <p class="text-ink-faint">Open all week · 9:00 AM – 9:00 PM</p>
            </address>
            <a href={MAPS_LINK} target="_blank" rel="noopener" class="btn btn-ghost btn-sm mt-4">
              Get Directions
            </a>
          </div>
        </div>

        <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-ink/8 pt-6 text-xs text-ink-faint sm:flex-row">
          <p>© {new Date().getFullYear()} Lucky Stationery & Sports. All rights reserved.</p>
          <p>Siddhipuram Colony · Indore · Madhya Pradesh</p>
        </div>
      </div>
    </footer>

    <!-- ===================== FLOATING WHATSAPP + CALL ===================== -->
    <div class="fabs" aria-label="Quick contact">
      <a
        class="fab fab-wa"
        href={WA_LINK}
        target="_blank"
        rel="noopener"
        aria-label="Chat with us on WhatsApp"
        title="WhatsApp"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.7.8-.8 1-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4 0-.5.2-.7l.4-.5c.1-.2.1-.3 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2.1 3.2 5 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.4-.4z" />
        </svg>
      </a>
      <a
        class="fab fab-call"
        href={`tel:${PHONE_TEL}`}
        aria-label="Call Lucky Stationery and Sports"
        title="Call"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.1 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.7a2 2 0 0 1 1.7 2z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <style is:global>
      .nav-link {
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--color-ink-soft);
        transition: color 0.2s ease, background-color 0.2s ease;
      }
      .nav-link:hover {
        color: var(--color-ink);
        background: rgb(15 23 42 / 0.05);
      }
      .mob-link {
        padding: 0.8rem 0.6rem;
        border-radius: 0.9rem;
        font-weight: 700;
        color: var(--color-ink);
        border-bottom: 1px solid rgb(15 23 42 / 0.06);
      }
      .mob-link:active { background: rgb(15 23 42 / 0.05); }
      #nav.scrolled { box-shadow: 0 12px 30px -22px rgb(15 23 42 / 0.7); }
    </style>

    <script>
      const nav = document.getElementById("nav");
      const toggle = document.getElementById("nav-toggle");
      const menu = document.getElementById("mobile-menu");

      const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      toggle?.addEventListener("click", () => {
        const open = menu?.classList.toggle("hidden") === false;
        toggle.setAttribute("aria-expanded", String(open));
      });

      menu?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => {
          menu.classList.add("hidden");
          toggle?.setAttribute("aria-expanded", "false");
        })
      );

      // Scroll reveal
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduced || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
